# Copy this file to .env.local (git-ignored) and fill in the values you have.
# Every one of these is optional — the site works with none of them set, it
# just won't have that particular feature turned on yet.

# The canonical URL this site is deployed at. Used for metadata, the
# sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://alterxtra.app

# Google Analytics 4 measurement ID (Admin > Data Streams > your stream).
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification (Settings > Ownership
# verification > HTML tag > copy just the content="..." value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Microsoft Clarity project ID (clarity.microsoft.com > Settings > Setup >
# Install manually > the id in the script snippet).
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Where the email-capture form (/api/subscribe) forwards new signups. Point
# this at a Zapier/Make webhook, or a Mailchimp/ConvertKit "add subscriber"
# webhook URL. Left unset, signups are accepted but only logged server-side.
EMAIL_CAPTURE_WEBHOOK_URL=

# Store listing links for the "Rate AlterX" buttons in the reviews section.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Contact address shown on the website's privacy notice.
NEXT_PUBLIC_CONTACT_EMAIL=support@alterxtra.app
