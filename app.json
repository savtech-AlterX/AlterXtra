{
  "expo": {
    "name": "Regrown",
    "slug": "AlterXtra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "regrown",
    "backgroundColor": "#f6f8f4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alterxtra.regrown"
    },
    "android": {
      "package": "com.alterxtra.regrown",
      "adaptiveIcon": {
        "backgroundColor": "#f6f8f4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Regrown uses your photo library so you can share before-and-after photos of your climate action.",
          "cameraPermission": "Regrown uses your camera so you can take before-and-after photos of your climate action."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "38ed9e85-27b8-48c6-afcd-f95aa83eabf8"
      }
    },
    "owner": "techsavs-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/38ed9e85-27b8-48c6-afcd-f95aa83eabf8"
    }
  }
}
