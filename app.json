{
  "expo": {
    "name": "AlterXtra",
    "slug": "AlterXtra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "alterxtra",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alterxtra.app"
    },
    "android": {
      "package": "com.alterxtra.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "AlterX uses your photo library to add photos to your identity albums.",
          "cameraPermission": "AlterX uses your camera to record video messages to your future self.",
          "microphonePermission": "AlterX uses your microphone to record audio for your future self video messages."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "AlterX uses Face ID to keep your identity data private if you enable App Lock."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3da8f5"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "38ed9e85-27b8-48c6-afcd-f95aa83eabf8"
      }
    },
    "owner": "techsavs-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/38ed9e85-27b8-48c6-afcd-f95aa83eabf8"
    }
  }
}
